{
  "name": "dsh-win-notify",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "DSH 会话执行完成 / 需要人工干预时通知：Tauri 桌面壳/浏览器（客户端半部分）或 Windows 系统 Toast（宿主半部分）。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "scripts": {
    "validate": "node ./scripts/validate.mjs",
    "test": "node ./scripts/unit-test.mjs && node ./scripts/client-unit-test.mjs"
  }
}
